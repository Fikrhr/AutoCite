{
  "manifest_version": 3,
  "name": "AutoCite",
  "version": "0.3.0",
  "description": "Rekomendasi sitasi ilmiah otomatis untuk Google Docs berbasis AI dan semantic search.",
  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://api.semanticscholar.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://api.openalex.org/*",
    "https://docs.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "796241063270-lghk5osog1ldcq3fj7239ufq1e1tl35m.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Buka AutoCite"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "side_panel": {
    "default_path": "popup.html"
  }
}