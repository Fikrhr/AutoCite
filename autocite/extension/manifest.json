{
  "manifest_version": 3,
  "name": "AutoCite",
  "version": "0.3.0",
  "description": "Rekomendasi sitasi ilmiah otomatis untuk Google Docs berbasis AI dan semantic search.",
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://api.semanticscholar.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "GANTI_DENGAN_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AutoCite" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://docs.google.com/document/*"], "js": ["content.js"] }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
